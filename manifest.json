{
  "manifest_version": 3,
  "name": "Channel Saver",
  "version": "1.9.4",
  "key": "",
  "description": "Save YouTube channels and videos into niches, find outliers and similar channels, track competitors and test thumbnails.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "downloads",
    "downloads.ui",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://yt3.ggpht.com/*",
    "https://studio.youtube.com/*",
    "https://letrestart.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-core.js",
        "busy.js",
        "content-similar.js",
        "content.js",
        "content-share.js",
        "content-badges.js",
        "content-shorts.js",
        "content-video.js",
        "content-thumbtest.js",
        "content-reply.js"
      ],
      "css": [
        "content.css",
        "content-tools.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "content-core.js",
        "busy.js",
        "content-reply.js"
      ],
      "css": [
        "content.css",
        "content-tools.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Channel Saver",
    "default_icon": {
      "16": "icons/icon16.png",
      "20": "icons/icon20.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "40": "icons/icon40.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
